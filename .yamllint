extends: default

rules:
  line-length: disable
  document-start: disable
  indentation: disable
  empty-lines:
    max: 2
    max-start: 1
    max-end: 1
  truthy: disable
  comments: disable
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1

ignore: |
  .storage/
  custom_components/
  .git/
