         "x": "$fn ({hass}) => {\n  const xs = [];\n  for (let t = 15; t <= 35.01; t += 0.25) xs.push(t);\n  return xs;\n}\n",
         "y": "$fn ({hass}) => {\n  const tgt = parseFloat(hass.states['sensor.active_vpd_target']?.state);\n  const tol = parseFloat(hass.states['input_number.vpd_tolerance']?.state);\n  if (isNaN(tgt) || isNaN(tol)) return [];\n  const v = tgt + tol;\n  const ys = [];\n  for (let t = 15; t <= 35.01; t += 0.25) {\n    const svp = 0.61078 * Math.exp((17.27 * t) / (t + 237.3));\n    ys.push(100 * (1 - v / svp));\n  }\n  return ys;\n}\n"
