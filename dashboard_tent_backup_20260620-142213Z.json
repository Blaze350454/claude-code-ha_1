      {
       "type": "entities",
       "title": "Flower Schedule",
       "entities": [
        {
         "entity": "input_datetime.flower_lights_on_time",
         "name": "Lights On"
        },
        {
         "entity": "input_datetime.flower_lights_off_time",
         "name": "Lights Off"
        }
       ]
      },
      {
       "type": "markdown",
       "content": "## Tent Lights\n{% set stage = states('input_select.growth_stage') %}\n{% set ns = namespace(on_t='', off_t='', lights_on=false, duration_h=0) %}\n{% if stage in ['Vegetative', 'Transition'] %}\n  {% set ns.on_t = states('input_datetime.veg_lights_on_time') %}\n  {% set ns.off_t = states('input_datetime.veg_lights_off_time') %}\n{% else %}\n  {% set ns.on_t = states('input_datetime.flower_lights_on_time') %}\n  {% set ns.off_t = states('input_datetime.flower_lights_off_time') %}\n{% endif %}\n{% set on_m = (ns.on_t.split(':')[0]|int * 60) + ns.on_t.split(':')[1]|int %}\n{% set off_m = (ns.off_t.split(':')[0]|int * 60) + ns.off_t.split(':')[1]|int %}\n{% set now_m = now().hour * 60 + now().minute %}\n{% if on_m < off_m %}\n  {% set ns.lights_on = now_m >= on_m and now_m < off_m %}\n  {% set ns.duration_h = (off_m - on_m) // 60 %}\n{% else %}\n  {% set ns.lights_on = now_m >= on_m or now_m < off_m %}\n  {% set ns.duration_h = (1440 - on_m + off_m) // 60 %}\n{% endif %}\n{% set next_m = off_m if ns.lights_on else on_m %}\n{% set diff = (next_m - now_m) % 1440 %}\n{% set on_fmt = as_timestamp(today_at(ns.on_t)) | timestamp_custom('%I:%M %p') %}\n{% set off_fmt = as_timestamp(today_at(ns.off_t)) | timestamp_custom('%I:%M %p') %}\n| | |\n|---|---|\n| **Stage** | {{ stage }} |\n| **Schedule** | {{ on_fmt }} to {{ off_fmt }} ({{ ns.duration_h }}h) |\n| **Tent Lights** | {{ 'ON' if ns.lights_on else 'OFF' }} |\n| **Next change** | {{ 'Off' if ns.lights_on else 'On' }} in {{ diff // 60 }}h {{ diff % 60 }}m |\n{% if stage == 'Transition' %}| **Transition** | Day {{ states('input_number.transition_day_counter')|int }} of 6 |{% endif %}\n"
      }
     ]
